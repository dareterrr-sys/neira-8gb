+// Neira expert steering
+void llm_graph_input_moe_steer::set_input(const llama_ubatch * ubatch) {
+    GGML_UNUSED(ubatch);
+    std::vector<float> data(n_expert*n_layer, 0.0f);
+    const char * path = getenv("NEIRA_MOE_STEER");
+    if (path) {
+        FILE * f = fopen(path, "rb");
+        if (f) {
+            const size_t n = fread(data.data(), sizeof(float), data.size(), f);
+            GGML_UNUSED(n);
+            fclose(f);
+        }
+    }
+    ggml_backend_tensor_set(steer, data.data(), 0, data.size()*sizeof(float));
+}
