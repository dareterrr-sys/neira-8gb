+// Neira expert steering
+ggml_tensor * llm_graph_context::build_inp_moe_steer(int64_t n_expert) const {
+    if (moe_steer) {
+        return moe_steer;
+    }
+    auto inp = std::make_unique<llm_graph_input_moe_steer>(n_expert, hparams.n_layer());
+    auto & cur = inp->steer;
+    cur = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, n_expert, hparams.n_layer());
+    ggml_set_input(cur);
+    cb(cur, "inp_moe_steer", -1);
+    res->add_input(std::move(inp));
+    moe_steer = cur;
+    return cur;
