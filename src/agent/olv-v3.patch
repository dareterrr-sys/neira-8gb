+_LEADING_TAGS = re.compile(r"^\s*((?:\[[^\[\]]+\]\s*)+)")
+_ANY_TAG = re.compile(r"\[([^\[\]]+)\]")
+
+
+def _spread_tags(text: str, live2d_model: Live2dModel, pending: list) -> str:
+    """Return the sentence text with its emotion tags spread over the answer (see actions_extractor)."""
+    keys = {k.lower() for k in live2d_model.emo_map}
+    m = _LEADING_TAGS.match(text)
+    if m:
+        names = [n for n in _ANY_TAG.findall(m.group(1)) if n.lower() in keys]
+        if len(names) > 1:
+            pending.extend(names[1:])
+            return f"[{names[0]}] " + text[m.end():]
+        return text
+    if pending and live2d_model.remove_emotion_keywords(text).strip() and not _ANY_TAG.search(text):
+        return f"[{pending.pop(0)}] " + text
+    return text
+
